# ---- Banco de dados (MySQL via Prisma) ----
DATABASE_URL="mysql://root:@localhost:3306/sistema_redacoes"

# ---- Autenticação ----
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
JWT_EXPIRES_IN="7d"

# ---- Servidor ----
PORT=3333

# ---- Google Gemini (OCR e avaliação de redações) ----
GEMINI_API_KEY=""

# ---- Cloudinary (upload de imagens de questão) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

#-- Para redefinir senha (Brevo, token por email):

# BREVO_API_KEY=a_chave_gerada
# EMAIL_REMETENTE=o_email_verificado_no_brevo
# FRONTEND_URL=http://localhost:3000

#-- Teste do pedido para redefinir senha por token(aparece no terminal do backend)
BREVO_API_KEY=
SMTP_HOST=

# ---- Migração de dados (script de exportação do Firebase) ----
# Caminho local para o JSON da service account do Firebase (não versionar!)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
